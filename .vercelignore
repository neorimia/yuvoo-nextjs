# Vercel Ignore File
# Files and directories to exclude from Vercel deployment

# Development files
.env.local
.env*.local
*.log
*.log.*

# Build artifacts (handled by Vercel)
.next
out
dist
build

# Dependencies (installed by Vercel)
node_modules

# Testing
coverage
.nyc_output
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentation (not needed in production)
docs/
memory-bank/
brief/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Misc
*.md
!README.md
.prettierrc*
.eslintrc*
# Keep tsconfig.json for path alias resolution
# tsconfig.json
drizzle.config.ts
