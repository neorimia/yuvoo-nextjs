# ============================================
# Yuvoo - Environment Variables Template
# ============================================
#
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control (it's in .gitignore)
#
# Usage:
#   cp .env.local.example .env.local
#   # Then edit .env.local with your actual values
#
# ============================================

# ============================================
# Database Configuration
# ============================================
# Neon Database (Serverless Postgres)
# Get connection string from: https://console.neon.tech
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL='postgresql://neondb_owner:npg_MYK8CDI1nWrm@ep-late-art-agkc45tk-pooler.c-2.eu-central-1.aws.neon.tech/neondb?sslmode=require'
DB_CONNECTION_LIMIT=10

# ============================================
# Authentication - Stack Auth
# ============================================
# Stack Auth project configuration
# Get these from: https://stack-auth.com
# NEXT_PUBLIC_* variables are exposed to the browser
# STACK_* variables are server-side only

# Project ID (public, exposed to browser)
NEXT_PUBLIC_STACK_PROJECT_ID="3ebde08a-7523-486b-98cc-efc1c65eb2be"

# Publishable client key (public, exposed to browser)
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="pck_btv3dwck7xgyr1k89msnb1zqhjpr4gp7qfag26d84y0pr"

# Secret server key (server-side only, never expose to browser)
STACK_SECRET_SERVER_KEY="ssk_xm02eg7dz74qk9wct946bjw4cwxd9gtxwqd0n9d59mesr"

# ============================================
# AI Service - OpenAI
# ============================================
# OpenAI API for AI Coach Quiz recommendations
# Get API key from: https://platform.openai.com/api-keys
# Model: gpt-4-turbo-preview
# Language: All AI responses must be in Romanian
OPENAI_API_KEY="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"

# ============================================
# Media Storage - Cloudinary
# ============================================
# Cloudinary for image uploads and CDN delivery
# Get credentials from: https://cloudinary.com/console
# NEXT_PUBLIC_* variables are exposed to the browser

# Cloud name (public, exposed to browser)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="yuvoo"

# API Key (server-side only)
CLOUDINARY_API_KEY="376877928148233"

# API Secret (server-side only, never expose to browser)
CLOUDINARY_API_SECRET="F0FI76DEuhYPrEoJyu3w3DzGBY"

# ============================================
# Email Service - Brevo (formerly Sendinblue)
# ============================================
# Brevo for transactional emails (booking confirmations, quiz results, etc.)
# Get API key from: https://app.brevo.com/settings/keys/api
# All emails must be in Romanian language

# Brevo API key (server-side only)
BREVO_API_KEY="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"

# Email sender configuration
BREVO_SENDER_EMAIL="noreply@yuvoo.ro"
BREVO_SENDER_NAME="Yuvoo - Platforma Sportivă pentru Copii"

# ============================================
# Application URLs
# ============================================
# Base URL for the application
# Development: http://localhost:3000
# Production: https://yuvoo.ro (or your production domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================
# Optional: Development/Testing
# ============================================
# Uncomment these for development/testing purposes

# Node environment (automatically set by Next.js, but can be overridden)
# NODE_ENV="development"

# Enable debug logging (optional)
# DEBUG="yuvoo:*"

# ============================================
# Security Notes
# ============================================
#
# ⚠️ IMPORTANT SECURITY REMINDERS:
#
# 1. NEVER commit .env.local to version control
# 2. NEVER expose server-side keys (STACK_SECRET_SERVER_KEY, CLOUDINARY_API_SECRET, etc.) to the browser
# 3. Use NEXT_PUBLIC_* prefix ONLY for variables that need to be accessible in the browser
# 4. Rotate API keys regularly
# 5. Use different keys for development, staging, and production
# 6. Store production secrets in Vercel environment variables (not in .env.local)
#
# ============================================
# Getting Started
# ============================================
#
# 1. Database (Neon):
#    - Sign up at https://neon.tech
#    - Create a new project
#    - Copy the connection string to DATABASE_URL
#
# 2. Authentication (Stack Auth):
#    - Sign up at https://stack-auth.com
#    - Create a new project
#    - Copy Project ID, Publishable Key, and Secret Key
#
# 3. AI (OpenAI):
#    - Sign up at https://platform.openai.com
#    - Create an API key
#    - Add billing (required for API access)
#
# 4. Media (Cloudinary):
#    - Sign up at https://cloudinary.com
#    - Get cloud name, API key, and API secret from dashboard
#
# 5. Email (Brevo):
#    - Sign up at https://www.brevo.com
#    - Create an API key
#    - Verify sender email address
#
# ============================================
